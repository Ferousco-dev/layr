# --- BACKEND URL ---
# Base URL of the Layr API (no trailing slash). The backend's FRONTEND_URL must equal this app's origin.
VITE_API_URL=http://localhost:8080

# --- PUBLIC SITE URL ---
# Where the site is served in production. Used for canonical links, social share tags, sitemap.xml and robots.txt.
VITE_SITE_URL=https://layr.appmd.dev

# --- LEGAL PAGES ---
# Shown in the Terms, the Privacy Policy and on the Contact page. The country is optional (for example "Nigeria").
VITE_OPERATOR_NAME=Layr
VITE_CONTACT_EMAIL=hello@layr.appmd.dev
VITE_GOVERNING_LAW=
