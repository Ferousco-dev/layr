# Production template. Copy to your secret manager; never commit real values.
APP_ENV=production
FRONTEND_URL=https://layr.appmd.dev
# Replace with the public host of this API. It must be https and under appmd.dev so the session cookie stays same-site.
FIGMA_REDIRECT_URI=https://api.layr.appmd.dev/auth/figma/callback
TEMP_WORKSPACE_ROOT=/var/lib/layr/jobs
# Set to the network of your reverse proxy so rate limiting sees real client addresses.
TRUSTED_PROXY_CIDRS=
HTTP_ADDRESS=:8080
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/layr?sslmode=require
REDIS_URL=rediss://:PASSWORD@HOST:6379/0
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=layr_session
SESSION_COOKIE_SECURE=true
SESSION_TTL=168h
OAUTH_STATE_TTL=10m
# Requests per minute: login routes per address, all /api/v1 per address, writes per user.
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_IMPORT_PER_MINUTE=6
# Figma importer: how long temporary workspaces live, the per-import time limit, and byte limits.
TEMP_WORKSPACE_TTL=24h
IMPORT_TIMEOUT=2m
MAX_SNAPSHOT_BYTES=134217728
MAX_WORKSPACE_BYTES=536870912
# Asset pipeline: largest single asset, total asset bytes per import, parallel downloads, files per import.
MAX_ASSET_SIZE_BYTES=52428800
MAX_IMPORT_ASSET_BYTES=268435456
ASSET_DOWNLOAD_CONCURRENCY=4
MAX_IMPORT_ASSETS=300
# Design IR: largest serialized design, nodes per design, and screens per import (at most 100).
MAX_IR_BYTES=67108864
MAX_IR_NODES=200000
MAX_SCREENS=100
LOG_LEVEL=info
