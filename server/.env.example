# Local development only. Replace credentials outside local Docker.
APP_ENV=development
FRONTEND_URL=http://localhost:3000
TEMP_WORKSPACE_ROOT=/tmp/layr/jobs
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted; empty ignores the header.
TRUSTED_PROXY_CIDRS=
HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=30s
HTTP_MAX_BODY_BYTES=1048576
HTTP_MAX_HEADER_BYTES=1048576
STARTUP_TIMEOUT=10s
READINESS_TIMEOUT=1s
READINESS_PROBE_TIMEOUT=500ms
POSTGRES_URL=postgres://layr:layr_local@localhost:5432/layr?sslmode=disable
POSTGRES_MAX_CONNECTIONS=10
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
# Requests per minute: login routes per address, all /api/v1 per address, writes per user.
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=30
RATE_LIMIT_IMPORT_PER_MINUTE=6
# Figma importer: how long temporary workspaces live, the per-import time limit, and byte limits.
TEMP_WORKSPACE_TTL=24h
IMPORT_TIMEOUT=5m
FIGMA_REQUESTS_PER_MINUTE=8
MAX_SNAPSHOT_BYTES=134217728
MAX_WORKSPACE_BYTES=536870912
# Asset pipeline: largest single asset, total asset bytes per import, parallel downloads, files per import.
MAX_ASSET_SIZE_BYTES=52428800
MAX_IMPORT_ASSET_BYTES=268435456
ASSET_DOWNLOAD_CONCURRENCY=4
MAX_IMPORT_ASSETS=300
# Design IR: largest serialized design, nodes per design, and screens per import (at most 100).
MAX_IR_BYTES=67108864
MAX_IR_NODES=200000
MAX_SCREENS=500
LOG_LEVEL=info
FIGMA_CLIENT_ID=replace-with-figma-client-id
FIGMA_CLIENT_SECRET=replace-with-figma-client-secret
FIGMA_REDIRECT_URI=http://localhost:8080/auth/figma/callback
# 32 random bytes, base64 encoded, for example: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktcmVwbGFjZS10aGlzLWtleSE=
SESSION_COOKIE_NAME=layr_session
# Set to false only for local plain-HTTP development; production rejects false.
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h
OAUTH_STATE_TTL=10m
